# Copy this file to keystore.properties and fill in your real values.
# keystore.properties and the .keystore file are both git-ignored on purpose:
# together they are the credential that lets someone publish as you.
#
# Path is relative to android/app/ (where the keystore normally sits).
storeFile=soothe-quest-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=soothe-quest
keyPassword=YOUR_KEY_PASSWORD
